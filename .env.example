# Happy Store — Frontend environment variables
# Copy to .env.local for local development (Vite only exposes variables
# prefixed with VITE_ to the browser — never put secrets here).

# Base path/URL the frontend uses for all API calls (see src/constants/api.ts).
# - Local dev: leave as "/api" — vite.config.ts proxies it to the backend
#   (defaults to http://localhost:4000; override with VITE_BACKEND_PROXY_TARGET).
# - Any deployment without a shared origin/reverse-proxy: set this to the
#   backend's full URL, e.g. "https://api.happystore.com/api".
VITE_API_BASE_URL="/api"

# Dev-only: where vite.config.ts's dev-server proxy forwards /api/* requests.
VITE_BACKEND_PROXY_TARGET="http://localhost:4000"
